# Telegram proxy
TELEGRAM_PROXY_URL=

# bot token from botfather
TELEGRAM_BOT_TOKEN=

# password for adding admins through the bot
ADMIN_PASSWORD=

# public id of your tg channel via @example
TELEGRAM_CHANNEL_ID=

# api key form Youtube data v3
YOUTUBE_API_KEY=

# channel id (starts with UC)
YOUTUBE_CHANNEL_ID=

# CRON checking timing (current: every 1 minute)
CHECK_CRON='*/1 * * * *'

# CRON checking timing for scheduled stream announcements
SCHEDULED_ANNOUNCEMENTS_CRON='*/1 * * * *'
